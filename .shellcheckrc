# ShellCheck configuration - MAXIMUM STRICTNESS
# https://www.shellcheck.net/wiki/

# Shell dialect (bash)
shell=bash

# Enable ALL optional checks - we want maximum strictness
# CI pins shellcheck version to avoid surprise breakage
enable=all

# External sources - allow sourcing files
external-sources=true

# Source path for finding sourced files
source-path=SCRIPTDIR
source-path=lib

# NO DISABLES - fix the code, don't silence the linter
